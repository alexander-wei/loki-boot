# .env.template
# Environment variables for the event publisher sidecar

# Loki authentication credentials
LOKI_USER=
LOKI_TOKEN=

# Loki API endpoint
LOKI_URL=

# Service name for Loki logging
SERVICE_NAME=event-publisher

# Optional explicit task/host IPv4 address. Leave empty for automatic discovery.
# Takes precedence over ECS metadata and hostname discovery.
PRIVATE_IP=
