# .env.template
# Environment variables for the event publisher sidecar

# Loki authentication credentials
LOKI_USER=
LOKI_TOKEN=

# Loki API endpoint
LOKI_URL=

# Service name for Loki logging
SERVICE_NAME=event-publisher

# Optional URL components written into each Loki log value. Leave blank to omit.
# SERVICE_PORT must be 1-65535; SERVICE_PROTOCOL must be http or https;
# SERVICE_URI must be a path beginning with / (for example, /api).
SERVICE_PORT=
SERVICE_PROTOCOL=
SERVICE_URI=

# Log values contain private_ip and timestamp, plus configured URL components
# as port (number), protocol, and uri (string), respectively.

# Optional explicit task/host IPv4 address. Leave empty for automatic discovery.
# Takes precedence over ECS metadata and hostname discovery.
PRIVATE_IP=

# ECS networking: auto (default) or awsvpc uses the task ENI from ECS metadata.
# Set host for ECS host-network tasks: uses the EC2 primary private IP (IMDSv2).
ECS_NETWORK_MODE=auto
